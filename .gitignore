scratch/

# Heavy generated output directories (HTML/PNG probe artifacts, not source) --
# wildcard catches every output_*/ dir (there are 20+ of these from one-off probe
# runs, new ones appear constantly) instead of enumerating each by name.
output_*/
output/
*_output/
layout_renders/

# Model weights / checkpoints (large binaries, never belong in git)
weights/
checkpoints/
model_cards/*.bin
model_licenses/*.bin

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Docs & planning/scratch text artifacts -- not core code, kept local only
docs/
prompt.txt
prompt_test.txt
project_roadmap.txt
plan_*.md
debug_diagonal.html

# Archived one-off research/probe scripts (2026-09-12 cleanup) -- kept locally for
# reference, not tracked in git.
scripts/archive/

# scripts/ has 30+ one-off probe/test/verify scripts accumulated across the
# project's history (real research artifacts, not throwaway junk, but not meant
# to ship in a fresh repo either). Default-ignore everything in scripts/ and
# explicitly allow only the small set that are live, current-production-adjacent
# entry points as of 2026-09-15. Add a new `!scripts/<name>.py` line here when a
# script graduates from one-off probe to something worth tracking long-term.
scripts/*
!scripts/demo_server.py
!scripts/cli.py
!scripts/run_full_pipeline.py
!scripts/pipeline_e2e_poster.py
!scripts/run_tendoo_v2_llm.py
!scripts/probe_diffusion_mask_adherence.py
!scripts/evaluate_all_prompt_test.py
