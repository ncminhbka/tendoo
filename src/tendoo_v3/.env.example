# ==============================================================================
# TENDOO v3 - CONFIGURATION ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# LLM Endpoint (OpenAI-compatible sidecar server)
# Ví dụ kiểm tra kết nối và xem danh sách model bằng lệnh curl:
# curl --location 'http://10.221.155.3:8004/v1/models' \
#      --header 'Authorization: Bearer <YOUR_API_KEY>'

TENDOO_V3_LLM_BASE_URL=http://10.221.155.3:8004/v1
TENDOO_V3_LLM_API_KEY=your_api_key_here

# Mô hình mạnh nhất được chọn:
# - Qwen/Qwen3.8-27B       (Khuyến nghị: Dense 27B, suy luận cấu trúc JSON & tiếng Việt xuất sắc nhất)
# - google/gemma-4-31B-it  (Dense 31B: Mạnh mẽ, chất lượng cao)
# - Qwen/Qwen3.6-35B-A3B   (MoE 35B/3B active: Tốc độ suy luận siêu tốc)
# - Qwen/Qwen3.5-4B        (Bản nhẹ: Dùng khi thiếu tài nguyên)
TENDOO_V3_LLM_MODEL=Qwen/Qwen3.8-27B
TENDOO_V3_LLM_TIMEOUT_S=60

# Cấu hình Server Demo & GPU
TENDOO_V3_SERVER_HOST=0.0.0.0
TENDOO_V3_SERVER_PORT=7860
TENDOO_V3_DEVICE_DIT=cuda:0
TENDOO_V3_DEVICE_AUX=cuda:1

# Giới hạn số lượng run folders lưu trữ tối đa trong output
TENDOO_V3_MAX_RUNS=100
