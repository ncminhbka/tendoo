# ==============================================================================
# TENDOO v3 - CONFIGURATION ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# LLM Backend:
# - local : Dùng trực tiếp Qwen3-4B có sẵn trên server (trong persistent-data/FLUX.2-klein-base-4B/text_encoder)
#           Chạy in-process trên GPU cuda:1, không cần mạng ngoài, không lo lỗi kết nối HTTP.
# - auto  : Thử gọi API trước, nếu lỗi kết nối / timeout sẽ tự động failover sang Local Qwen3-4B trên GPU.
# - api   : Chỉ gọi qua HTTP endpoint OpenAI-compatible.
TENDOO_V3_LLM_BACKEND=local

# LLM Endpoint (Khi dùng backend=api hoặc backend=auto)
# Ví dụ 1 (cluster nội bộ mặc định):
TENDOO_V3_LLM_BASE_URL=http://10.221.155.3:8004/v1
TENDOO_V3_LLM_API_KEY=your_api_key_here
# Ví dụ 2 (LLM khác cùng dải mạng, endpoint OpenAI-compatible, cần Bearer token riêng --
# đã xác nhận qua GET /v1/models: phục vụ "google/gemma-4-E4B-it", context 131072 token):
# TENDOO_V3_LLM_BASE_URL=http://10.211.139.11:8000/v1
# TENDOO_V3_LLM_API_KEY=<đặt token thật ở đây, KHÔNG commit file .env này lên git>
# TENDOO_V3_LLM_MODEL=google/gemma-4-E4B-it

# Mô hình mục tiêu:
# - Qwen/Qwen3.6-35B-A3B   (Đang chạy thực tế trên cluster nội bộ: MoE 35B, siêu tốc, hỗ trợ chat_template_kwargs)
# - Qwen/Qwen3.8-27B       (Dense 27B)
# - google/gemma-4-E4B-it  (Xác nhận thật trên server 10.211.139.11:8000, context 131072 token --
#                           KHÔNG phải Qwen nên request tự động BỎ chat_template_kwargs/extra_body,
#                           xem generate_creative_plan() trong llm_planner.py)
TENDOO_V3_LLM_MODEL=Qwen/Qwen3.6-35B-A3B
TENDOO_V3_LLM_TIMEOUT_S=60
# Timeout riêng cho bước kết nối TCP (giây) -- tách khỏi timeout đọc phản hồi ở trên
# để fail nhanh khi server đích không phản hồi ngay, không chờ hết TENDOO_V3_LLM_TIMEOUT_S.
TENDOO_V3_LLM_CONNECT_TIMEOUT_S=3.0
# Đặt =1 để CHO PHÉP gọi API dù TENDOO_V3_LLM_API_KEY rỗng (server đích không yêu cầu xác thực).
# Mặc định (bỏ trống/0): nếu thiếu API key, hệ thống bỏ qua gọi API và failover thẳng sang
# Local Qwen3-4B / fallback heuristic -- xem generate_creative_plan() trong llm_planner.py.
# TENDOO_V3_LLM_ALLOW_NO_KEY=1

# Cấu hình Server Demo & GPU
TENDOO_V3_SERVER_HOST=0.0.0.0
TENDOO_V3_SERVER_PORT=7860
TENDOO_V3_DEVICE_DIT=cuda:0
TENDOO_V3_DEVICE_AUX=cuda:1

# Giới hạn số lượng run folders lưu trữ tối đa trong output
TENDOO_V3_MAX_RUNS=100
